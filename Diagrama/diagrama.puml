@startuml Juego

' Mas espacio entre cajas para que las flechas no se pisen
skinparam nodesep 60
skinparam ranksep 80

package personajes {
  class wachington  {
    position
    imagen
    mochila
    objetivo
    image()
    esSolido()
    estaAlLadoDe(otro)
    interactuar()
    guardar(objeto)
    tiene(objeto)
  }

  interface Interactuable {
    position()
    image()
    esSolido()
    esInteractuable()
    interactuar()
  }

  class rasta  {
    hablar(mensaje)
    interactuar()
  }
  class companieroClase {
    hablar(mensaje)
    interactuar()
  }
  class portero {
    interactuar()
  }
  class tecnico  {
    interactuar()
  }
}



package movimientos {
class Tablero {
  anchoHabitacion
    altoHabitacion
    configurar(ancho, alto)
    ancho()
    alto()
    estaDentro(posicion)
    hayObstaculoEn(posicion)
    puedeOcuparse(posicion)
  }
class Movimientos {
  mover(personaje, destino)
    arriba(personaje)
    abajo(personaje)
    izquierda(personaje)
    derecha(personaje)
 }
}


package salas {
class Sala {
  fondos()
  objetos()
  posicioninicial()
  ancho()
  alto()
  cargar()
  configurar()
  ocultarFueraDeSala(x,y)
}

Object habitacionActual {
  salaactual()
  irA(sala,posicionllegada)
}

' El #FFAA55 le da el color naranja en el diagrama, es solo un detalle ' 
' El O para referenciar que es un objeto (explicar en la presentacion)
  class salaEntrada <<(O,#FFAA55) object>> 
  class salaPasillo <<(O,#FFAA55) object>>
  class salaAula <<(O,#FFAA55) object>>
  class salaLabo <<(O,#FFAA55) object>>
  class salaPasilloBedelia <<(O,#FFAA55) object>>
  class salaBuffet <<(O,#FFAA55) object>>

'lo pongo asi para diferenciar de las decorativas ' 
class "puertas (puertaXDesdeY)" as puertas <<(O,#FFAA55) object>> {
    interactuar()
  }
class ascensor <<(O,#FFAA55) object>> {
    interactuar()
  }

class controles <<(O,#FFAA55) object>> {
    configurar()
  }

class MascaraFueraDeSala {
    position
    image()
  }
}

package historia {
  interface Objetivo {
    interactuarConPortero()
    interactuarConTecnico()
    interactuarConAscensor()
  }

  class objetivoLlegarAlAula <<(O,#FFAA55) object>>
  class objetivoArreglarAscensor <<(O,#FFAA55) object>>
  class objetivoConseguirLlave <<(O,#FFAA55) object>>
  class objetivoLimpiarEntrada <<(O,#FFAA55) object>>
}


package decorados {
 class ObjetoDecorativo {
  position
    esInteractuable()
  }
  class ObjetoDecorativoSolido {
    esSolido()
  }
  class ObjetoDecorativoNoSolido {
    esSolido()
  }
}



package utiles {
class computadora {
  hablar(mensaje)
  interactuaur()
}

class tp {
  estado
  
}
  

interface EstadoTp {
    mensajeRasta()
    mensajeCompa()
    mensajeCompu()
    avanzarConRasta()
    avanzarConCompu()
  }

class sinTp <<(O,#FFAA55) object>>
class tpIncompleto <<(O,#FFAA55) object>>
class tpCompleto <<(O,#FFAA55) object>>
class tpEntregado <<(O,#FFAA55) object>>
}


' Relaciones ' 

' Herencia' 
ObjetoDecorativo <|-- ObjetoDecorativoSolido
ObjetoDecorativo <|-- ObjetoDecorativoNoSolido

Sala <|-d- salaEntrada
Sala <|-d- salaPasillo
Sala <|-u- salaAula
Sala <|-u- salaLabo
Sala <|-d- salaPasilloBedelia
Sala <|-u- salaBuffet

' Implimentacion ' 
Interactuable <|.. rasta
Interactuable <|.. companieroClase
Interactuable <|.. portero
Interactuable <|.. tecnico
Interactuable <|.. ascensor
Interactuable <|.. puertas
Interactuable <|.. computadora

EstadoTp <|.. sinTp
EstadoTp <|.. tpIncompleto
EstadoTp <|.. tpCompleto
EstadoTp <|.. tpEntregado

Objetivo <|.. objetivoLlegarAlAula
Objetivo <|.. objetivoArreglarAscensor
Objetivo <|.. objetivoConseguirLlave
Objetivo <|.. objetivoLimpiarEntrada

'asosiacion' 
wachington --> Objetivo :objetivo
wachington o--> tp :mochila
wachington ..> Interactuable :interactuar()

tp --> EstadoTp : estado
rasta ..> tp
companieroClase ..> tp
computadora ..> tp

portero ..> wachington : objetivo()
tecnico ..> wachington : objetivo()
ascensor ..> wachington : objetivo()

controles ..> Movimientos
controles ..> wachington
Movimientos ..> Tablero

Sala ..> Tablero : configurar()
Sala ..> controles
Sala ..> habitacionActual
Sala ..> MascaraFueraDeSala : crea
Sala o-->  ObjetoDecorativo : objetos()
Sala o-->  Interactuable : objetos()

habitacionActual --> Sala : salaActual
puertas ..> habitacionActual : irA()

@enduml
