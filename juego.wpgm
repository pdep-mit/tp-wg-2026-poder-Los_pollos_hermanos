program AprobameRasta {
	game.title("Grupo: Los Pollos Hermanos | Aprobame, Rasta")
	game.height(10)
	game.width(10)
	game.cellSize(64)
	game.ground("x64sprites/mapa/baldosa.png")
	game.addVisual(wachington) //movemos el wachington de acuerdo a las flechas
	game.addVisual(rasta)
	game.addVisual(companieroClase)
	game.addVisual(new Mesa(position = game.at(1, 8)))
	game.addVisual(new MesaIzquierda(position = game.at(0, 8)))
	game.addVisual(new MesaDerecha(position = game.at(2, 8)))
	game.addVisual(new Mesa(position = game.at(4, 8)))
	game.addVisual(new MesaIzquierda(position = game.at(3, 8)))
	game.addVisual(new MesaDerecha(position = game.at(5, 8)))
	game.addVisual(new Mesa(position = game.at(7, 8)))
	game.addVisual(new MesaIzquierda(position = game.at(6, 8)))
	game.addVisual(new MesaDerecha(position = game.at(8, 8)))
	game.addVisual(computadoraLabo)
	game.addVisual(new ComputadoraDecorativa(position = game.at(4, 8)))
	game.addVisual(new ComputadoraDecorativa(position = game.at(7, 8)))



	// Movilidad 
	keyboard.up().onPressDo({ movimiento.arriba(wachington) })
  	keyboard.down().onPressDo({ movimiento.abajo(wachington) })
  	keyboard.left().onPressDo({ movimiento.izquierda(wachington) })
 	keyboard.right().onPressDo({ movimiento.derecha(wachington) })
	keyboard.e().onPressDo({ wachington.interactuar() })

	game.start()
}

program Entrada {
	game.cellSize(64)
	game.width(18)
	game.height(10)
	salaEntrada.cargar()
	game.start()
}

