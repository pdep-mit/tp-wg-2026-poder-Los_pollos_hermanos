import entrada.*

program AprobameRasta {
	game.title("Grupo: Los Pollos Hermanos | Aprobame, Rasta")
	game.height(10)
	game.width(10)
	game.cellSize(64)
	game.ground("x64sprites/mapa/baldosa.png")
	game.addVisual(alumno) //movemos el alumno de acuerdo a las flechas
	game.addVisual(rasta)
	game.addVisual(companieroClase)
	game.addVisual(new Mesa(position = game.at(1, 8)))
	game.addVisual(new MesaIzquierda(position = game.at(0, 8)))
	game.addVisual(new MesaDerecha(position = game.at(2, 8)))
	game.addVisual(new Mesa(position = game.at(4, 8)))
	game.addVisual(new MesaIzquierda(position = game.at(3, 8)))
	game.addVisual(new MesaDerecha(position = game.at(5, 8)))
	game.addVisual(new Mesa(position = game.at(7, 8)))
	game.addVisual(new MesaIzquierda(position = game.at(6, 8)))
	game.addVisual(new MesaDerecha(position = game.at(8, 8)))
	game.addVisual(computadora)
	game.addVisual(new ComputadoraDecorativa(position = game.at(4, 8)))
	game.addVisual(new ComputadoraDecorativa(position = game.at(7, 8)))



	// Movilidad 
	keyboard.up().onPressDo({ movimiento.arriba(alumno) })
  	keyboard.down().onPressDo({ movimiento.abajo(alumno) })
  	keyboard.left().onPressDo({ movimiento.izquierda(alumno) })
 	keyboard.right().onPressDo({ movimiento.derecha(alumno) })
	keyboard.e().onPressDo({ alumno.interactuar() })

	game.start()
}

program Entrada {
	game.title("Entrada")
	game.height(10)
	game.width(15)
	game.cellSize(64)
	game.ground("x64sprites/mapa/baldosa.png")
	


	//paredes
	game.addVisual(new ParedFrente(position = game.at(1, 9)))
	game.addVisual(new ParedFrente(position = game.at(2, 9)))
	game.addVisual(new ParedFrente(position = game.at(3, 9)))
	game.addVisual(new ParedFrente(position = game.at(4, 9)))
	game.addVisual(new ParedFrente(position = game.at(5, 9)))
	game.addVisual(new ParedFrente(position = game.at(6, 9)))
	game.addVisual(new ParedFrente(position = game.at(7, 9)))
	game.addVisual(new ParedFrente(position = game.at(8, 9)))
	game.addVisual(new ParedFrente(position = game.at(9, 9)))
	game.addVisual(new ParedFrente(position = game.at(10, 9)))
	game.addVisual(new ParedFrente(position = game.at(13, 9)))
	game.addVisual(new ParedFrente(position = game.at(14, 9)))

	game.addVisual(new ParedIzq(position = game.at(0, 0)))
	game.addVisual(new ParedIzq(position = game.at(0, 1)))
	game.addVisual(new ParedIzq(position = game.at(0, 2)))
	game.addVisual(new ParedIzq(position = game.at(0, 3)))
	game.addVisual(new ParedIzq(position = game.at(0, 4)))
	game.addVisual(new ParedIzq(position = game.at(0, 5)))
	game.addVisual(new ParedIzq(position = game.at(0, 6)))
	game.addVisual(new ParedIzq(position = game.at(0, 7)))
	game.addVisual(new ParedIzq(position = game.at(0, 8)))
	game.addVisual(new ParedIzq(position = game.at(0, 9)))

	game.addVisual(new ParedDer(position = game.at(14, 0)))
	game.addVisual(new ParedDer(position = game.at(14, 1)))
	game.addVisual(new ParedDer(position = game.at(14, 2)))
	game.addVisual(new ParedDer(position = game.at(14, 3)))
	game.addVisual(new ParedDer(position = game.at(14, 4)))
	game.addVisual(new ParedDer(position = game.at(14, 5)))
	game.addVisual(new ParedDer(position = game.at(14, 6)))
	game.addVisual(new ParedDer(position = game.at(14, 7)))
	game.addVisual(new ParedDer(position = game.at(14, 8)))
	game.addVisual(new ParedDer(position = game.at(14, 9)))

	//Personajes/Interactuables
	game.addVisual(portero)
	game.addVisual(tecnico)
	game.addVisual(ascensor)
	
	//Areas no accesibles
	game.addVisual(puertaAMMedio)
	game.addVisual(puertaAMIzq)
	game.addVisual(puertaAMDer)
	game.addVisual(puertaBaño)
	game.addVisual(puertaSalidaMedio)
	game.addVisual(puertaSalidaIzq)
	game.addVisual(puertaSalidaDer)
	game.addVisual(escalerasIzq)
	game.addVisual(escalerasDer)

	//Tacho de basura con papeles
	game.addVisual(suciedadPapeles1)
	game.addVisual(suciedadPapeles2)
	game.addVisual(suciedadPapeles3)
	game.addVisual(suciedadPapeles4)
	game.addVisual(suciedadPapeles5)
	game.addVisual(tachoBasura)

	//No interactuables
	game.addVisual(new MesaHorizontalPapeles(position = game.at(2, 3)))
	game.addVisual(new MesaArribaHorizontal(position = game.at(2, 4)))
	game.addVisual(new MesaAbajoHorizontal(position = game.at(2, 2)))
	game.addVisual(new CartelUTNIzq(position = game.at(10, 4)))
	game.addVisual(new CartelUTNDer(position = game.at(11, 4)))




	game.addVisual(alumno)
	
	// Movilidad 
	keyboard.up().onPressDo({ movimiento.arriba(alumno) })
  	keyboard.down().onPressDo({ movimiento.abajo(alumno) })
  	keyboard.left().onPressDo({ movimiento.izquierda(alumno) })
 	keyboard.right().onPressDo({ movimiento.derecha(alumno) })
	keyboard.e().onPressDo({ alumno.interactuar() })
	game.start()
}

program Pasillo {
	game.title("Pasillo")
	game.height(6)
	game.width(18)
	game.cellSize(64)
	game.ground("x64sprites/mapa/baldosa.png")

	//paredes
	game.addVisual(new ParedFrente(position = game.at(1, 5)))
	game.addVisual(new ParedFrente(position = game.at(2, 5)))
	game.addVisual(new ParedFrente(position = game.at(3, 5)))
	game.addVisual(new ParedFrente(position = game.at(4, 5)))
	game.addVisual(new ParedFrente(position = game.at(5, 5)))
	game.addVisual(new ParedFrente(position = game.at(6, 5)))
	game.addVisual(new ParedCarteleraIzq(position = game.at(7, 5)))
	game.addVisual(new ParedCarteleraLlena(position = game.at(8, 5)))
	game.addVisual(new ParedCarteleraDer(position = game.at(9, 5)))
	game.addVisual(new ParedFrente(position = game.at(10, 5)))
	game.addVisual(new ParedFrente(position = game.at(11, 5)))
	game.addVisual(new ParedFrente(position = game.at(13, 5)))
	game.addVisual(new ParedFrente(position = game.at(14, 5)))
	game.addVisual(new ParedFrente(position = game.at(15, 5)))
	game.addVisual(new ParedFrente(position = game.at(16, 5)))

	game.addVisual(new ParedIzq(position = game.at(0, 0)))
	game.addVisual(new ParedIzq(position = game.at(0, 1)))
	game.addVisual(new ParedIzq(position = game.at(0, 3)))
	game.addVisual(new ParedIzq(position = game.at(0, 4)))
	game.addVisual(new ParedIzq(position = game.at(0, 5)))

	game.addVisual(new ParedDer(position = game.at(17, 0)))
	game.addVisual(new ParedDer(position = game.at(17, 1)))
	game.addVisual(new ParedDer(position = game.at(17, 4)))
	game.addVisual(new ParedDer(position = game.at(17, 5)))

	//PUERTAS
	game.addVisual(puertaAulaDesdePasillo)
	game.addVisual(puertaLaboDesdePasillo)
	game.addVisual(puertaBedelia1DesdePasillo)
	game.addVisual(puertaBedelia2DesdePasillo)
	game.addVisual(escalerasDesdePasillo1)
	game.addVisual(escalerasDesdePasillo2)

	//MISC
	game.addVisual(new CartelAgua(position = game.at(7, 1)))
	game.addVisual(new Aguita(position = game.at(6, 1)))
	game.addVisual(new Aguita(position = game.at(8, 1)))
	game.addVisual(new Aguita(position = game.at(4, 4)))
	game.addVisual(new TaraguiPared(position = game.at(4, 5)))

	//INTERACTUABLES
	game.addVisual(taraguiPiso)



	//PERSONAJES
	game.addVisual(hanz)
	game.addVisual(conserje)

	game.addVisual(alumno)
	
	// Movilidad 
	keyboard.up().onPressDo({ movimiento.arriba(alumno) })
  	keyboard.down().onPressDo({ movimiento.abajo(alumno) })
  	keyboard.left().onPressDo({ movimiento.izquierda(alumno) })
 	keyboard.right().onPressDo({ movimiento.derecha(alumno) })
	keyboard.e().onPressDo({ alumno.interactuar() })
	game.start()
}

