import wollok.game.*
import personajes.*

program AprobameRasta {
	game.title("Grupo: Los Pollos Hermanos | Aprobame, Rasta")
	game.height(10)
	game.width(10)
	game.cellSize(64)
	game.boardGround("fondo.png")
	game.addVisualCharacter(alumno) //movemos el alumno de acuerdo a las flechas
	game.addVisual(rasta)
	game.addVisual(companieroClase)
	// game.addVisual(computadora)

	keyboard.e().onPressDo({ alumno.hablarCon(rasta) })

	

	game.start()
}
