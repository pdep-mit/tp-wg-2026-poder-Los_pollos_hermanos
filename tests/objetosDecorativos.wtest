import objetos.*
import wollok.game.*

describe "Objetos decorativos" {

  test "Los objetos sólidos heredan posición y solidez" {
    const mesa = new ObjetoDecorativoSolido(position = game.at(1, 2), image = "x64sprites/mapa/mesa-medio.png")

    assert.equals(game.at(1, 2), mesa.position())
    assert.that(mesa.esSolido())
  }

  test "Los objetos no sólidos heredan su comportamiento" {
    const flecha = new ObjetoDecorativoNoSolido(position = game.at(3, 4), image = "x64sprites/mapa/flecha-der.png")

    assert.equals(game.at(3, 4), flecha.position())
    assert.that(!flecha.esSolido())
  }

  test "Las paredes usan la superclase de objetos sólidos" {
    const pared = new ObjetoDecorativoSolido(position = game.at(5, 6), image = "x64sprites/mapa/pared-frente.png")

    assert.equals(game.at(5, 6), pared.position())
    assert.that(pared.esSolido())
  }
}
