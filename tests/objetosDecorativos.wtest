import objetosDecorados.*
import objetosParedes.*
import wollok.game.*

describe "Objetos decorativos" {

  test "Los objetos sólidos heredan posición, solidez e interactuabilidad" {
    const mesa = new Mesa(position = game.at(1, 2))

    assert.equals(game.at(1, 2), mesa.position())
    assert.that(mesa.esSolido())
    assert.that(!mesa.esInteractuable())
  }

  test "Los objetos no sólidos heredan su comportamiento" {
    const flecha = new FlechaDer(position = game.at(3, 4))

    assert.equals(game.at(3, 4), flecha.position())
    assert.that(!flecha.esSolido())
    assert.that(!flecha.esInteractuable())
  }

  test "Las paredes usan la superclase de objetos sólidos" {
    const pared = new ParedFrente(position = game.at(5, 6))

    assert.equals(game.at(5, 6), pared.position())
    assert.that(pared.esSolido())
    assert.that(!pared.esInteractuable())
  }
}
